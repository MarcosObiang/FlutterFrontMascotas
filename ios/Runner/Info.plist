	<!-- CONFIGURACIÓN DE KEYBOARD -->
	<key>UIKeyboardAppearance</key>
	<string>UIKeyboardAppearanceDark</string>
	
	<!-- CONFIGURACIÓN DE WIDGET -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>